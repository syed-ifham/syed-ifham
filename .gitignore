# ═══════════════════════════════════════
# GitHub Profile Repository .gitignore
# ═══════════════════════════════════════

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Node modules (if any scripts are added)
node_modules/
package-lock.json

# Python artifacts (if any scripts are added)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*.egg-info/
dist/
build/

# Temporary files
*.tmp
*.temp
.cache/

README_SETUP.md